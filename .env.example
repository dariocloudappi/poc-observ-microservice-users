# ================================
# Server
# ================================
PORT=8080

# ================================
# Logging
# ================================
# TRACE | DEBUG | INFO | WARN | ERROR
LOG_LEVEL=INFO

# ================================
# Azure SQL Database
# ================================
SQL_SERVER=your-server.database.windows.net
SQL_SERVER_PORT=1433
SQL_DATABASE=your-database
SQL_USERNAME=your-username
SQL_PASSWORD=your-password

# ================================
# Basic Auth
# ================================
BASIC_AUTH_USER=1234
BASIC_AUTH_PASSWORD=1234

# ============================================================
# OPENTELEMETRY - CONFIGURACIÓN ZERO-CODE
# Estas variables las lee el agente OTEL en tiempo de ejecución.
# NO se necesita código adicional en la aplicación.
# ============================================================

# Nombre del servicio que aparecerá en New Relic
OTEL_SERVICE_NAME=microservice-users

# Endpoint OTLP de New Relic (HTTPS, puerto 4318)
OTEL_EXPORTER_OTLP_ENDPOINT=your-otlp-endpoint:4318

# Tu License Key de New Relic (Ingest - License, no User API Key)
OTEL_EXPORTER_OTLP_HEADERS=api-key=your_new_relic_license_key

# Protocolo OTLP: http/protobuf es el recomendado para HTTPS
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

# Habilitar exportación de trazas, métricas y logs
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp

# Atributos del recurso (aparecen como tags en New Relic)
OTEL_RESOURCE_ATTRIBUTES=service.name=microservice-users,deployment.environment=local,service.version=1.0.0

# Intervalo de exportación de métricas en milisegundos (30 segundos)
OTEL_METRIC_EXPORT_INTERVAL=30000

# Muestreo de trazas: 1.0 = 100% (reducir en producción si hay alto volumen)
OTEL_TRACES_SAMPLER=parentbased_always_on

# Captura de atributos adicionales en logs (desactivado por defecto en el agente)
# Habilita los addKeyValue() de SLF4J 2.x como atributos estructurados en New Relic
OTEL_INSTRUMENTATION_LOGBACK_APPENDER_EXPERIMENTAL_CAPTURE_KEY_VALUE_PAIR_ATTRIBUTES=true
# Captura todas las entradas de MDC como atributos (trace/span IDs, request IDs, etc.)
OTEL_INSTRUMENTATION_LOGBACK_APPENDER_EXPERIMENTAL_CAPTURE_MDC_ATTRIBUTES=*
# Redirige los logs internos del propio agente OTEL a través de Logback → New Relic
# Sin esta variable los logs del agente van a JUL y NO llegan a New Relic
OTEL_JAVAAGENT_LOGGING=application

# ============================================================
# JAVA AGENT (para ejecución local)
# ============================================================
# Descomentar y ajustar la ruta al agente OTEL descargado con mvn package
# JAVA_TOOL_OPTIONS=-javaagent:./target/otel-javaagent.jar

# ================================
# Azure App Service (solo para mvn azure-webapp:deploy)
# ================================
# AZURE_SUBSCRIPTION_ID=<subscription-id>
# AZURE_RESOURCE_GROUP=<resource-group>
# AZURE_APP_NAME=<app-service-name>
# AZURE_REGION=westeurope

# ================================
# Como usar este fichero:
#   Linux/Mac:  export $(grep -v '^#' .env | xargs) && mvn spring-boot:run
#   PowerShell: Get-Content .env | Where-Object { $_ -notmatch '^#' -and $_ -match '=' } | ForEach-Object { $k,$v = $_ -split '=',2; [System.Environment]::SetEnvironmentVariable($k, $v) }
#               mvn spring-boot:run
# ================================
